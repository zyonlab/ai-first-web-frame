{
  "name": "@mvp/fragment-order-form",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    "./island": "./src/island.tsx",
    "./manifest": "./src/manifest.ts",
    "./render": "./src/render.ts"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "build:island-browser": "tsdown src/island.browser.ts --format esm --platform browser --external react --external react/jsx-runtime --external react-dom/client --external @mvp/trade-contracts --external @mvp/ui/shadcn --out-dir dist-browser --no-dts --minify --clean",
    "build": "tsdown src/server.ts --format esm --platform node --dts",
    "test": "pnpm -w exec vitest run fragments/order-form/tests fragments/order-form/src",
    "test:watch": "pnpm -w exec vitest fragments/order-form/tests fragments/order-form/src",
    "typecheck": "pnpm exec tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mvp/contracts": "workspace:*",
    "@mvp/data": "workspace:*",
    "@mvp/fragment-host": "workspace:*",
    "@mvp/interaction": "workspace:*",
    "@mvp/observability": "workspace:*",
    "@mvp/request-context": "workspace:*",
    "@mvp/store": "workspace:*",
    "@mvp/trade-contracts": "workspace:*",
    "@mvp/trade-data": "workspace:*",
    "@mvp/ui": "workspace:*",
    "fastify": "^4.28.1",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@mvp/runtime": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.11.0"
  }
}
