{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@mvp/contracts": ["./packages/contracts/src/index.ts"],
      "@mvp/assets": ["./packages/assets/src/index.ts"],
      "@mvp/data": ["./packages/data/src/index.ts"],
      "@mvp/design-system": ["./packages/design-system/src/index.ts"],
      "@mvp/design-tokens": ["./packages/design-tokens/src/index.ts"],
      "@mvp/interaction": ["./packages/interaction/src/index.ts"],
      "@mvp/islands": ["./packages/islands/src/index.ts"],
      "@mvp/trade-client": ["./packages/trade-client/src/index.ts"],
      "@mvp/observability": ["./packages/observability/src/index.ts"],
      "@mvp/optimizer": ["./packages/optimizer/src/index.ts"],
      "@mvp/request": ["./packages/request/src/index.ts"],
      "@mvp/request-context": ["./packages/request-context/src/index.ts"],
      "@mvp/runtime": ["./packages/runtime/src/index.ts"],
      "@mvp/storage": ["./packages/storage/src/index.ts"],
      "@mvp/store": ["./packages/store/src/index.ts"],
      "@mvp/trade-chart": ["./domains/trade-chart/src/index.ts"],
      "@mvp/trade-contracts": ["./domains/trade-contracts/src/index.ts"],
      "@mvp/trade-data": ["./domains/trade-data/src/index.ts"],
      "@mvp/trade-prefs": ["./domains/trade-prefs/src/index.ts"],
      "@mvp/trade-theme": ["./domains/trade-theme/src/index.ts"],
      "@mvp/ui": ["./packages/ui/src/index.ts"],
      "@mvp/ui/*": ["./packages/ui/src/*"],
      "@mvp/workers": ["./packages/workers/src/index.ts"]
    }
  }
}
