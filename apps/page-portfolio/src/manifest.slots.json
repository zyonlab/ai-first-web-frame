[
  {
    "name": "portfolioSummary",
    "fragment": "portfolio-summary",
    "channel": "canary",
    "strategy": "dynamic-ssr",
    "timeoutMs": 200,
    "cachePolicy": {
      "ttl": 0,
      "tags": ["portfolio", "account"],
      "vary": ["tenant", "props"]
    },
    "required": true
  },
  {
    "name": "pnlChart",
    "fragment": "pnl-chart",
    "channel": "canary",
    "strategy": "isr",
    "timeoutMs": 200,
    "cachePolicy": {
      "ttl": 60,
      "tags": ["portfolio", "pnl"],
      "vary": ["tenant", "locale", "props"]
    },
    "required": false
  }
]
