{
  "name": "@mvp/request",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "AGENT.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/proxicat/ai-first-web-frame.git",
    "directory": "packages/request"
  },
  "homepage": "https://github.com/proxicat/ai-first-web-frame#readme",
  "scripts": {
    "test": "pnpm -w exec vitest run packages/request/src",
    "test:watch": "pnpm -w exec vitest packages/request/src",
    "build": "tsdown src/index.ts --format esm --dts",
    "typecheck": "pnpm exec tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mvp/contracts": "workspace:*",
    "@mvp/observability": "workspace:*",
    "@mvp/request-context": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.11.0",
    "zod": "^3.23.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
