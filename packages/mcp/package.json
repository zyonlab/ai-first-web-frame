{
  "name": "@mvp/mcp",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "mvp-mcp": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "AGENT.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/proxicat/ai-first-web-frame.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/proxicat/ai-first-web-frame#readme",
  "scripts": {
    "start": "pnpm -w exec tsx packages/mcp/src/server.ts",
    "test": "pnpm -w exec vitest run packages/mcp/src",
    "test:watch": "pnpm -w exec vitest packages/mcp/src",
    "build": "tsdown src/index.ts src/server.ts --format esm --dts",
    "typecheck": "pnpm exec tsgo -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@mvp/contracts": "workspace:*",
    "@mvp/trade-data": "workspace:*",
    "tsdown": "^0.11.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
