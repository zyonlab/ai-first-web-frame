{
  "name": "@mvp/ui",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./AppNav": {
      "types": "./dist/AppNav/index.d.ts",
      "import": "./dist/AppNav/index.js"
    },
    "./Button": {
      "types": "./dist/Button/index.d.ts",
      "import": "./dist/Button/index.js"
    },
    "./Card": {
      "types": "./dist/Card/index.d.ts",
      "import": "./dist/Card/index.js"
    },
    "./Image": {
      "types": "./dist/Image/index.d.ts",
      "import": "./dist/Image/index.js"
    },
    "./ProductCardBase": {
      "types": "./dist/ProductCardBase/index.d.ts",
      "import": "./dist/ProductCardBase/index.js"
    },
    "./Section": {
      "types": "./dist/Section/index.d.ts",
      "import": "./dist/Section/index.js"
    },
    "./Skeleton": {
      "types": "./dist/Skeleton/index.d.ts",
      "import": "./dist/Skeleton/index.js"
    },
    "./shadcn": {
      "types": "./dist/shadcn/index.d.ts",
      "import": "./dist/shadcn/index.js"
    },
    "./shadcn/globals.css": "./src/shadcn/globals.css",
    "./tailwind.config": "./tailwind.config.ts"
  },
  "files": [
    "dist",
    "README.md",
    "AGENT.md"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/proxicat/ai-first-web-frame.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/proxicat/ai-first-web-frame#readme",
  "scripts": {
    "test": "pnpm -w exec vitest run packages/ui/src",
    "test:watch": "pnpm -w exec vitest packages/ui/src",
    "build": "tsdown src/index.ts src/AppNav/index.ts src/Button/index.ts src/Card/index.ts src/Image/index.ts src/ProductCardBase/index.ts src/Section/index.ts src/Skeleton/index.ts src/shadcn/index.ts --format esm --dts",
    "typecheck": "pnpm exec tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mvp/contracts": "workspace:*",
    "@mvp/design-system": "workspace:*",
    "@mvp/design-tokens": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slider": "^1.4.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toast": "^1.2.19",
    "@radix-ui/react-tooltip": "^1.2.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.2",
    "tsdown": "^0.11.0"
  }
}
