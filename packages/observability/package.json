{
  "name": "@mvp/observability",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rum": {
      "types": "./dist/rum.d.ts",
      "import": "./dist/rum.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "AGENT.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/proxicat/ai-first-web-frame.git",
    "directory": "packages/observability"
  },
  "homepage": "https://github.com/proxicat/ai-first-web-frame#readme",
  "scripts": {
    "test": "pnpm -w exec vitest run packages/observability/src",
    "test:watch": "pnpm -w exec vitest packages/observability/src",
    "build": "tsdown src/index.ts src/rum.ts --format esm --dts",
    "typecheck": "pnpm exec tsgo -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "tsdown": "^0.11.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
