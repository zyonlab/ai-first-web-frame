{
  "name": "@mvp/runtime",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./seo": {
      "types": "./dist/seo.d.ts",
      "import": "./dist/seo.js"
    },
    "./live": {
      "types": "./dist/live.d.ts",
      "import": "./dist/live.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "AGENT.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/proxicat/ai-first-web-frame.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/proxicat/ai-first-web-frame#readme",
  "scripts": {
    "test": "pnpm -w exec vitest run packages/runtime/src",
    "test:watch": "pnpm -w exec vitest packages/runtime/src",
    "build": "tsdown src/index.ts src/react.tsx src/seo.ts src/live.ts --format esm --dts",
    "typecheck": "pnpm exec tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mvp/contracts": "workspace:*",
    "@mvp/request-context": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mvp/observability": "workspace:*",
    "@testing-library/react": "^16.0.0",
    "react": "^18.3.1",
    "tsdown": "^0.11.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
