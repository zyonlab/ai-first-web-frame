{
  "name": "ai-first-web-frame",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.13.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter './apps/*' --filter './fragments/*' dev",
    "dev:shell": "pnpm --filter @mvp/shell-gateway dev",
    "dev:page-home": "pnpm --filter @mvp/page-home dev",
    "dev:page-product": "pnpm --filter @mvp/page-product dev",
    "dev:fragment:promotion-banner": "pnpm --filter @mvp/fragment-promotion-banner dev",
    "dev:fragment:recommendation-widget": "pnpm --filter @mvp/fragment-recommendation-widget dev",
    "typecheck": "tsx scripts/tsgo-typecheck.mts",
    "typecheck:legacy": "tsc -b --pretty false",
    "lint": "pnpm exec oxlint .",
    "format": "pnpm exec biome format --write .",
    "check": "pnpm exec biome check .",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r --parallel test:watch",
    "test:coverage": "pnpm exec vitest run --coverage",
    "build": "pnpm -r build",
    "e2e": "pnpm exec playwright test",
    "smoke": "tsx scripts/docker-smoke.mts",
    "affected": "tsx scripts/affected.mts",
    "graph": "tsx scripts/query-registry.mts",
    "dev:component": "tsx scripts/dev-component.mts",
    "mcp:devx": "tsx tools/mcp-devx/src/server.mts",
    "register:fragment": "tsx scripts/register-fragment.mts",
    "mount:slot": "tsx scripts/mount-slot.mts",
    "promote:fragment": "tsx scripts/promote-fragment.mts",
    "rollback:fragment": "tsx scripts/rollback-fragment.mts",
    "audit:similarity": "pnpm --filter @mvp/component-similarity-check start -- --ci",
    "audit:bundle": "pnpm --filter @mvp/bundle-budget-check start -- --ci",
    "audit:css": "pnpm --filter @mvp/css-budget-check start -- --ci",
    "audit:deps": "pnpm --filter @mvp/dependency-audit start -- --ci",
    "audit:optimizer": "pnpm --filter @mvp/optimization-audit start -- --ci",
    "audit:boundary": "pnpm --filter @mvp/server-client-boundary-check start -- --ci",
    "verify": "tsx scripts/verify.mts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@playwright/test": "^1.45.3",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript/native-preview": "latest",
    "@vitest/coverage-v8": "^4.1.9",
    "happy-dom": "^14.12.3",
    "oxlint": "^0.6.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.9"
  }
}
